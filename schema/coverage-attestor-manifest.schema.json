{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/coverage-attestor-manifest.schema.json",
  "title": "Manifesto do coverage attestor",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "version", "constitution_version", "implementation_sha256", "authority"],
  "properties": {
    "manifest_version": {"const": 1},
    "id": {"const": "evolutive.coverage.attestor"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_only", "may_change_checker_outcome"],
      "properties": {
        "coverage_only": {"const": true},
        "may_change_checker_outcome": {"const": false}
      }
    }
  }
}
