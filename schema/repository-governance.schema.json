{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/repository-governance.schema.json",
  "title": "Contrato de governança do repositório",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "provider",
    "repository",
    "default_branch",
    "merge_policy",
    "main_branch",
    "external_enforcement"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "provider": {"const": "github"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "default_branch": {"const": "main"},
    "merge_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_methods", "preserve_head_branch"],
      "properties": {
        "allowed_methods": {
          "type": "array",
          "const": ["squash"]
        },
        "preserve_head_branch": {"const": true}
      }
    },
    "main_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_pull_request",
        "required_status_checks",
        "require_conversation_resolution",
        "require_linear_history",
        "block_force_pushes",
        "block_deletions",
        "bypass_actors"
      ],
      "properties": {
        "require_pull_request": {"const": true},
        "required_status_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "require_conversation_resolution": {"const": true},
        "require_linear_history": {"const": true},
        "block_force_pushes": {"const": true},
        "block_deletions": {"const": true},
        "bypass_actors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "external_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "required", "verification_mode"],
      "properties": {
        "mechanism": {
          "type": "string",
          "enum": ["ruleset", "branch-protection"]
        },
        "required": {"const": true},
        "verification_mode": {
          "const": "provider-state-audit"
        }
      }
    }
  }
}
