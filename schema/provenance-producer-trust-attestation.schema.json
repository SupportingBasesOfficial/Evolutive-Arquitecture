{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/provenance-producer-trust-attestation.schema.json",
  "title": "Attestation de confiança de producer de provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_version", "constitution_version", "subject", "producer", "evaluator", "evaluation", "authority"],
  "properties": {
    "attestation_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration_sha256", "authorized_artifacts_sha256", "evidence_sha256", "governance_context_sha256"],
      "properties": {
        "declaration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorized_artifacts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "governance_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementation_sha256", "manifest_sha256", "observation_basis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observation_basis": {"enum": ["declared", "observed"]}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementation_sha256", "manifest_sha256"],
      "properties": {
        "id": {"const": "evolutive.provenance.producer_trust_attestor"},
        "version": {"const": "0.1.0"},
        "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reproduced_exactly", "capabilities_safe"],
      "properties": {
        "verdict": {"const": "verified"},
        "reproduced_exactly": {"const": true},
        "capabilities_safe": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_only", "may_assert_semantic_relation", "may_assert_rule_outcome", "may_assert_semantic_exhaustiveness"],
      "properties": {
        "trust_only": {"const": true},
        "may_assert_semantic_relation": {"const": false},
        "may_assert_rule_outcome": {"const": false},
        "may_assert_semantic_exhaustiveness": {"const": false}
      }
    }
  }
}
