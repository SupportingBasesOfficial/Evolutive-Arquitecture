{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/positive-result-policy.schema.json",
  "title": "Política de evidência positiva para agregação de resultados",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "constitution_version", "rules"],
  "properties": {
    "policy_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "checker", "positive_derivation"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"},
          "checker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"},
              "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
            }
          },
          "positive_derivation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_status", "require_alignment", "require_complete_coverage", "require_zero_unclassified_files"],
            "properties": {
              "source_status": {"const": "unknown"},
              "require_alignment": {"const": true},
              "require_complete_coverage": {"const": true},
              "require_zero_unclassified_files": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
