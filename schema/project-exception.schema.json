{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/project-exception.schema.json",
  "title": "Exceção de conformidade do projeto consumidor",
  "description": "Registro auditável de uma solicitação de exceção a uma regra constitucional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_id",
    "rule_id",
    "constitution_version",
    "context",
    "justification",
    "responsible",
    "risks_accepted",
    "compensating_controls",
    "condition_evidence",
    "scope",
    "validity",
    "decision"
  ],
  "properties": {
    "exception_id": {
      "type": "string",
      "pattern": "^EXC-[0-9]{4,}$"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "constitution_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "context": {
      "type": "string",
      "minLength": 10
    },
    "justification": {
      "type": "string",
      "minLength": 20
    },
    "responsible": {
      "type": "string",
      "minLength": 3
    },
    "risks_accepted": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 5}
    },
    "compensating_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 5}
    },
    "condition_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "evidence"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 5}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_on", "review_condition"],
      "properties": {
        "expires_on": {
          "type": ["string", "null"],
          "format": "date"
        },
        "review_condition": {
          "type": ["string", "null"],
          "minLength": 5
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "authority", "decided_at"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["approved", "rejected"]
        },
        "authority": {
          "type": "string",
          "minLength": 3
        },
        "decided_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
