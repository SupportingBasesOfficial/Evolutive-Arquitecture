{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/observation-policy.schema.json",
  "title": "Política declarativa de observações arquiteturais obrigatórias",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "constitution_version", "required_observations"],
  "properties": {
    "policy_version": {"const": 1},
    "constitution_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "required_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "adapter_version"],
        "properties": {
          "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "adapter_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      }
    }
  }
}
