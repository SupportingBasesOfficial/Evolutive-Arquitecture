{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/ecosystem-inventory.schema.json",
  "title": "Inventário governado de superfícies de código detectadas",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "constitution_version", "subject", "scope", "evaluator", "detected_surfaces", "unclassified_files"],
  "properties": {
    "inventory_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_sha256", "catalog_sha256"],
      "properties": {
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "catalog_scope_only"],
      "properties": {
        "basis": {"const": "governed_ecosystem_catalog"},
        "catalog_scope_only": {"const": true}
      }
    },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "implementation_sha256"],
      "properties": {
        "id": {"const": "evolutive.ecosystem.discoverer"},
        "version": {"const": "0.1.0"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "detected_surfaces": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface_id", "ecosystem", "extensions_detected", "files_count", "paths_sha256", "observation"],
        "properties": {
          "surface_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "ecosystem": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "extensions_detected": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "files_count": {"type": "integer", "minimum": 1},
          "paths_sha256": {"$ref": "#/$defs/sha256"},
          "observation": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["adapter_id", "adapter_version"],
                "properties": {
                  "adapter_id": {"type": "string"},
                  "adapter_version": {"type": "string"}
                }
              }
            ]
          }
        }
      }
    },
    "unclassified_files": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "extensions"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "extensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
