{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/rule-decision.schema.json",
  "title": "Decisão de ciclo de vida de regra",
  "description": "Registro canônico e auditável de uma transição de estado de uma regra constitucional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "from_status",
    "to_status",
    "effective_in",
    "motivation",
    "impact",
    "adoption",
    "evidence",
    "enforcement_readiness",
    "decision"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "from_status": {
      "type": "string",
      "enum": ["proposed", "experimental", "active", "deprecated", "revoked"]
    },
    "to_status": {
      "type": "string",
      "enum": ["experimental", "active", "deprecated", "revoked"]
    },
    "effective_in": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "motivation": {
      "type": "string",
      "minLength": 20
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "summary"],
      "properties": {
        "compatibility": {
          "type": "string",
          "enum": ["compatible", "incompatible", "none"]
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "transition"],
      "properties": {
        "plan": {
          "type": "string",
          "minLength": 10
        },
        "transition": {
          "type": ["string", "null"],
          "minLength": 3
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "enforcement_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "mechanism", "gaps"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["ready", "limited", "not_applicable"]
        },
        "mechanism": {
          "type": "string",
          "minLength": 3
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "authority", "decided_at"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["approved", "rejected"]
        },
        "authority": {
          "type": "string",
          "minLength": 2
        },
        "decided_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
