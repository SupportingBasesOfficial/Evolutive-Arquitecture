{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/observed-provenance-manifest.schema.json",
  "title": "Manifest brokerado de provenance observada",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "constitution_version", "transformations"],
  "properties": {
    "manifest_version": {"const": 1},
    "constitution_version": {"const": "0.2.0"},
    "transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provenance_class", "inputs", "outputs", "candidate_relations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "provenance_class": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
          "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
          "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
          "candidate_relations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
          },
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "sha256"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source", "generated_source", "ast", "ir", "object", "library", "binary", "metadata", "build_manifest", "package"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
