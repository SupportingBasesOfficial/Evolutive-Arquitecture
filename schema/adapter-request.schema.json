{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/adapter-request.schema.json",
  "title": "Requisição limitada para adapter de ecossistema",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "adapter_id", "constitution_version", "components", "files"],
  "properties": {
    "request_version": {"const": 1},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/architecture-policy.schema.json#/$defs/component"}
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "text"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "text": {"type": "string"}
        }
      }
    }
  }
}
