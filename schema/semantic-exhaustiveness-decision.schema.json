{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/semantic-exhaustiveness-decision.schema.json",
  "title": "Decisão auditável de exaustividade semântica",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_version", "sequence", "constitution_version", "subject", "snapshot", "review", "decision"],
  "properties": {
    "decision_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "semantic_content_sha256", "target_status"],
      "properties": {
        "kind": {"enum": ["taxonomy", "rule_profile"]},
        "id": {"type": "string", "minLength": 1},
        "semantic_content_sha256": {"$ref": "#/$defs/sha256"},
        "target_status": {"const": "established"}
      }
    },
    "snapshot": {
      "oneOf": [
        {"$ref": "#/$defs/taxonomySnapshot"},
        {"$ref": "#/$defs/profileSnapshot"}
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "counterexample_search", "evidence", "unresolved_gaps"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normative_text_coverage",
            "indirect_dependency_forms",
            "dynamic_resolution",
            "configuration_and_wiring",
            "data_and_contract_coupling",
            "cross_runtime_and_ffi",
            "interprocess_and_distributed",
            "behavioral_conventions",
            "language_and_tooling_independence",
            "adversarial_counterexample_review"
          ],
          "properties": {
            "normative_text_coverage": {"type": "boolean"},
            "indirect_dependency_forms": {"type": "boolean"},
            "dynamic_resolution": {"type": "boolean"},
            "configuration_and_wiring": {"type": "boolean"},
            "data_and_contract_coupling": {"type": "boolean"},
            "cross_runtime_and_ffi": {"type": "boolean"},
            "interprocess_and_distributed": {"type": "boolean"},
            "behavioral_conventions": {"type": "boolean"},
            "language_and_tooling_independence": {"type": "boolean"},
            "adversarial_counterexample_review": {"type": "boolean"}
          }
        },
        "counterexample_search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["performed", "methods", "cases"],
          "properties": {
            "performed": {"type": "boolean"},
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 10}
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "disposition", "rationale"],
                "properties": {
                  "description": {"type": "string", "minLength": 10},
                  "disposition": {"enum": ["covered", "added_relation", "not_applicable", "unresolved"]},
                  "rationale": {"type": "string", "minLength": 10}
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference", "summary"],
            "properties": {
              "kind": {"enum": ["normative_analysis", "adversarial_review", "implementation_evidence", "formal_argument", "external_reference"]},
              "reference": {"type": "string", "minLength": 3},
              "summary": {"type": "string", "minLength": 10}
            }
          }
        },
        "unresolved_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 10}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "authority", "decided_at", "rationale"],
      "properties": {
        "outcome": {"enum": ["approved", "rejected"]},
        "authority": {"type": "string", "minLength": 2},
        "decided_at": {"type": "string", "format": "date"},
        "rationale": {"type": "string", "minLength": 20}
      }
    },
    "supersedes": {"type": ["string", "null"], "minLength": 3}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "profileRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "required", "normative_sources"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "required": {"type": "boolean"},
        "normative_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(statement|scope\\.(applies_to|excludes)\\[[0-9]+\\]|compliance\\.(pass_conditions|fail_conditions)\\[[0-9]+\\])$"}
        }
      }
    },
    "taxonomySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy_version", "constitution_version", "relations"],
      "properties": {
        "taxonomy_version": {"const": 1},
        "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}}
      }
    },
    "profileSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_version", "constitution_version", "rule_id", "rule_contract_sha256", "relations"],
      "properties": {
        "profile_version": {"const": 1},
        "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"},
        "rule_contract_sha256": {"$ref": "#/$defs/sha256"},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profileRelation"}}
      }
    }
  }
}
