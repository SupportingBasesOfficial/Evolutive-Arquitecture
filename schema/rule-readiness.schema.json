{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/rule-readiness.schema.json",
  "title": "Avaliação de prontidão de regra",
  "description": "Evidência auditável de prontidão para evolução do ciclo de vida de uma regra constitucional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_version",
    "rule_id",
    "assessed_status",
    "target_status",
    "verdict",
    "criteria",
    "enforcement",
    "evidence",
    "assessment"
  ],
  "properties": {
    "assessment_version": {"const": 1},
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "assessed_status": {
      "type": "string",
      "enum": ["proposed", "experimental", "active", "deprecated"]
    },
    "target_status": {
      "type": "string",
      "enum": ["experimental", "active"]
    },
    "verdict": {
      "type": "string",
      "enum": ["not_ready", "experimental_ready", "active_ready"]
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_is_observable",
        "compliance_is_observable",
        "evidence_collection_plan_exists",
        "enforcement_matches_declared_level",
        "exception_governance_ready"
      ],
      "properties": {
        "scope_is_observable": {"type": "boolean"},
        "compliance_is_observable": {"type": "boolean"},
        "evidence_collection_plan_exists": {"type": "boolean"},
        "enforcement_matches_declared_level": {"type": "boolean"},
        "exception_governance_ready": {"type": "boolean"}
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_level", "mechanism_available", "checker_outcomes", "gaps"],
      "properties": {
        "declared_level": {
          "type": "string",
          "enum": ["automatic", "semiautomatic", "review", "declarative"]
        },
        "mechanism_available": {"type": "boolean"},
        "checker_outcomes": {
          "type": "string",
          "enum": ["pass_fail", "fail_only", "unknown_only", "not_applicable"]
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "summary"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["rule_contract", "checker", "test", "governance", "review", "adoption"]
          },
          "reference": {"type": "string", "minLength": 3},
          "summary": {"type": "string", "minLength": 10}
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessor", "assessed_at"],
      "properties": {
        "assessor": {"type": "string", "minLength": 2},
        "assessed_at": {"type": "string", "format": "date"}
      }
    }
  }
}
