{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/semantic-coverage-evaluator-manifest.schema.json",
  "title": "Manifesto da autoridade de cobertura semântica",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "version", "constitution_version", "implementation_sha256", "authority"],
  "properties": {
    "manifest_version": {"const": 1},
    "id": {"const": "evolutive.semantic.coverage"},
    "version": {"const": "0.1.0"},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.$"},
    "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_coverage_only", "may_assert_complete_rule_semantics", "may_produce_rule_pass", "may_change_rule_status"],
      "properties": {
        "semantic_coverage_only": {"const": true},
        "may_assert_complete_rule_semantics": {"const": false},
        "may_produce_rule_pass": {"const": false},
        "may_change_rule_status": {"const": false}
      }
    }
  }
}
