{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/semantic-exhaustiveness-review-evidence.schema.json",
  "title": "Pacote auditável de evidência para revisão de exaustividade semântica",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_version", "constitution_version", "subject", "snapshot", "review", "conclusion"],
  "properties": {
    "review_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "semantic_content_sha256"],
      "properties": {
        "kind": {"enum": ["taxonomy", "rule_profile"]},
        "id": {"type": "string", "minLength": 1},
        "semantic_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot": {
      "oneOf": [
        {"$ref": "#/$defs/taxonomySnapshot"},
        {"$ref": "#/$defs/profileSnapshot"}
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "dimensions", "counterexamples", "evidence", "residual_gaps"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 10}
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normative_text_coverage",
            "indirect_dependency_forms",
            "dynamic_resolution",
            "configuration_and_wiring",
            "data_and_contract_coupling",
            "cross_runtime_and_ffi",
            "interprocess_and_distributed",
            "behavioral_conventions",
            "language_and_tooling_independence",
            "adversarial_counterexample_review"
          ],
          "properties": {
            "normative_text_coverage": {"$ref": "#/$defs/dimension"},
            "indirect_dependency_forms": {"$ref": "#/$defs/dimension"},
            "dynamic_resolution": {"$ref": "#/$defs/dimension"},
            "configuration_and_wiring": {"$ref": "#/$defs/dimension"},
            "data_and_contract_coupling": {"$ref": "#/$defs/dimension"},
            "cross_runtime_and_ffi": {"$ref": "#/$defs/dimension"},
            "interprocess_and_distributed": {"$ref": "#/$defs/dimension"},
            "behavioral_conventions": {"$ref": "#/$defs/dimension"},
            "language_and_tooling_independence": {"$ref": "#/$defs/dimension"},
            "adversarial_counterexample_review": {"$ref": "#/$defs/dimension"}
          }
        },
        "counterexamples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "scenario", "assessment", "rationale"],
            "properties": {
              "id": {"type": "string", "pattern": "^CE-[0-9]{3}$"},
              "scenario": {"type": "string", "minLength": 10},
              "assessment": {"enum": ["covered", "not_applicable", "potential_gap", "confirmed_gap"]},
              "relation_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
              },
              "rationale": {"type": "string", "minLength": 20}
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference", "claim"],
            "properties": {
              "kind": {"enum": ["normative_analysis", "adversarial_review", "implementation_evidence", "formal_argument", "external_reference"]},
              "reference": {"type": "string", "minLength": 3},
              "claim": {"type": "string", "minLength": 20}
            }
          }
        },
        "residual_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 20}
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reviewed_at", "reviewer", "rationale"],
      "properties": {
        "verdict": {"enum": ["supports_established", "supports_rejection", "inconclusive"]},
        "reviewed_at": {"type": "string", "format": "date"},
        "reviewer": {"type": "string", "minLength": 2},
        "rationale": {"type": "string", "minLength": 30}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["supported", "unsupported", "inconclusive"]},
        "rationale": {"type": "string", "minLength": 20}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "profileRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "required", "normative_sources"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "required": {"type": "boolean"},
        "normative_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(statement|scope\\.(applies_to|excludes)\\[[0-9]+\\]|compliance\\.(pass_conditions|fail_conditions)\\[[0-9]+\\])$"}
        }
      }
    },
    "taxonomySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy_version", "constitution_version", "relations"],
      "properties": {
        "taxonomy_version": {"const": 1},
        "constitution_version": {"$ref": "#/$defs/semver"},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}}
      }
    },
    "profileSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_version", "constitution_version", "rule_id", "rule_contract_sha256", "relations"],
      "properties": {
        "profile_version": {"const": 1},
        "constitution_version": {"$ref": "#/$defs/semver"},
        "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"},
        "rule_contract_sha256": {"$ref": "#/$defs/sha256"},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profileRelation"}}
      }
    }
  }
}
