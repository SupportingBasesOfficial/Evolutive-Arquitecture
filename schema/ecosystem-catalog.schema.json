{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/ecosystem-catalog.schema.json",
  "title": "Catálogo governado de superfícies de código",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "constitution_version", "surfaces"],
  "properties": {
    "catalog_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ecosystem", "extensions", "observation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "ecosystem": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}},
          "observation": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["adapter_id", "adapter_version"],
                "properties": {
                  "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
                  "adapter_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
                }
              }
            ]
          }
        }
      }
    }
  }
}
