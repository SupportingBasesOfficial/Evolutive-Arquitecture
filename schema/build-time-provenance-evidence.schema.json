{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/build-time-provenance-evidence.schema.json",
  "title": "Evidência portável de provenance de build-time",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_version", "constitution_version", "authority", "producer", "transformations"],
  "properties": {
    "evidence_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_trust", "may_assert_semantic_relation", "may_assert_rule_outcome"],
      "properties": {
        "producer_trust": {"const": "unverified"},
        "may_assert_semantic_relation": {"const": false},
        "may_assert_rule_outcome": {"const": false}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"enum": ["compiler", "macro_processor", "code_generator", "build_system", "linker", "packager", "compiler_plugin", "provenance_adapter"]}
      }
    },
    "transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provenance_class", "inputs", "outputs", "candidate_relations", "observation_basis"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "provenance_class": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/artifact"}
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/artifact"}
          },
          "candidate_relations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
          },
          "observation_basis": {"enum": ["observed", "declared"]},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "sha256"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source", "generated_source", "ast", "ir", "object", "library", "binary", "metadata", "build_manifest", "package"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
