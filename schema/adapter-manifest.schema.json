{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/adapter-manifest.schema.json",
  "title": "Manifesto de adapter de ecossistema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "version", "constitution_version", "ecosystem", "runtime", "capabilities"],
  "properties": {
    "manifest_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "ecosystem": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entrypoint", "implementation_sha256"],
      "properties": {
        "kind": {"const": "builtin"},
        "entrypoint": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"},
        "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_access", "file_extensions", "max_file_bytes", "network", "subprocess", "environment"],
      "properties": {
        "content_access": {"const": "text"},
        "file_extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}
        },
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "network": {"const": false},
        "subprocess": {"const": false},
        "environment": {"const": false}
      }
    }
  }
}
