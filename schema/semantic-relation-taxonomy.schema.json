{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/semantic-relation-taxonomy.schema.json",
  "title": "Taxonomia governada de relações semanticamente relevantes",
  "type": "object",
  "additionalProperties": false,
  "required": ["taxonomy_version", "constitution_version", "exhaustiveness", "relations"],
  "properties": {
    "taxonomy_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "exhaustiveness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["not_established", "established"]},
        "rationale": {"type": "string", "minLength": 1},
        "decision_reference": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
