{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/architecture-evidence.schema.json",
  "title": "Evidência arquitetural portável do consumidor",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_version", "constitution_version", "producer", "graph"],
  "properties": {
    "evidence_version": {"const": 1},
    "constitution_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {"enum": ["manual", "adapter"]},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "graph": {
      "$ref": "#/$defs/graph"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roots", "may_depend_on", "public_surface"],
      "properties": {
        "id": {"$ref": "#/$defs/componentId"},
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "may_depend_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentId"}
        },
        "public_surface": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_component",
        "target_component",
        "source_path",
        "target_path",
        "kind"
      ],
      "properties": {
        "source_component": {"$ref": "#/$defs/componentId"},
        "target_component": {"$ref": "#/$defs/componentId"},
        "source_path": {"$ref": "#/$defs/relativePath"},
        "target_path": {"$ref": "#/$defs/relativePath"},
        "kind": {
          "enum": ["import", "reference", "call", "inheritance", "composition", "data"]
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "dependencies"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component"}
        },
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency"}
        }
      }
    }
  }
}
