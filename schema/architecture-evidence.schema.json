{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/architecture-evidence.schema.json",
  "title": "Evidência arquitetural portável do consumidor",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_version", "constitution_version", "producer", "graph"],
  "properties": {
    "evidence_version": {"const": 1},
    "constitution_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {"enum": ["manual", "adapter"]},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "coverage", "broker_audit", "errors"],
      "properties": {
        "ecosystem": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files_received", "files_parsed", "bytes_received", "unresolved_references"],
          "properties": {
            "files_received": {"type": "integer", "minimum": 0},
            "files_parsed": {"type": "integer", "minimum": 0},
            "bytes_received": {"type": "integer", "minimum": 0},
            "unresolved_references": {"type": "integer", "minimum": 0}
          }
        },
        "broker_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "broker_version", "files_considered", "files_delivered", "bytes_read",
            "inventory_sha256", "delivered_content_sha256", "missing_roots",
            "skipped_symlinks", "skipped", "project_root_disclosed"
          ],
          "properties": {
            "broker_version": {"const": 1},
            "files_considered": {"type": "integer", "minimum": 0},
            "files_delivered": {"type": "integer", "minimum": 0},
            "bytes_read": {"type": "integer", "minimum": 0},
            "inventory_sha256": {"$ref": "#/$defs/sha256"},
            "delivered_content_sha256": {"$ref": "#/$defs/sha256"},
            "missing_roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/concretePath"}},
            "skipped_symlinks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/concretePath"}},
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "reason"],
                "properties": {
                  "path": {"$ref": "#/$defs/concretePath"},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            },
            "project_root_disclosed": {"const": false}
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path", "message"],
            "properties": {
              "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "path": {"$ref": "#/$defs/concretePath"},
              "message": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "graph": {"$ref": "#/$defs/graph"}
  },
  "allOf": [{"if": {"properties": {"producer": {"properties": {"kind": {"const": "adapter"}}}}}, "then": {"required": ["observation"]}}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "concretePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*\\[\\]]).+$"},
    "componentId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "roots", "may_depend_on", "public_surface"],
      "properties": {
        "id": {"$ref": "#/$defs/componentId"},
        "roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/concretePath"}},
        "may_depend_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
        "public_surface": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}}
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["source_component", "target_component", "source_path", "target_path", "kind"],
      "properties": {
        "source_component": {"$ref": "#/$defs/componentId"},
        "target_component": {"$ref": "#/$defs/componentId"},
        "source_path": {"$ref": "#/$defs/concretePath"},
        "target_path": {"$ref": "#/$defs/concretePath"},
        "kind": {"enum": ["import", "reference", "call", "inheritance", "composition", "data"]}
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["components", "dependencies"],
      "properties": {
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}
      }
    }
  }
}
