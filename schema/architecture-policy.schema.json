{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupportingBasesOfficial/Evolutive-Arquitecture/blob/main/schema/architecture-policy.schema.json",
  "title": "Política arquitetural declarada pelo consumidor",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "constitution_version", "components"],
  "properties": {
    "policy_version": {"const": 1},
    "constitution_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "concretePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*\\[\\]]).+$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roots", "may_depend_on", "public_surface"],
      "properties": {
        "id": {"$ref": "#/$defs/componentId"},
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/concretePath"}
        },
        "may_depend_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentId"}
        },
        "public_surface": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    }
  }
}
